# ── Database (this monorepo's own Postgres/Supabase project) ────────────────
SUPABASE_DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# ── This app's own Supabase project (for storage: product/partner photo
#    uploads, and any other data this app still stores locally, e.g.
#    testimonials, gallery, partner records themselves) ────────────────────
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service role secret — from Supabase dashboard, Project Settings > API>"
SUPABASE_STORAGE_BUCKET="media"

# ── Main Songtai Life database — READ ONLY, used to fetch products and FAQs
#    live so this app never stores its own duplicate copy of them. This is
#    the actual live Songtai Life project; the anon key is safe to use here
#    since it's public by design (protected by Row Level Security).
