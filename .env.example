# ── Custom domain resolution (frontend) ──────────────────────────────────────
# Comma-separated list of THIS app's own known hostnames (its Railway default
# domain, and/or a future custom production domain for the platform itself —
# NOT an individual partner's custom domain like coachnelson.site, which is
# looked up dynamically from the database instead). Leave unset/empty in
# local dev — localhost is always treated as a known app hostname regardless.
VITE_APP_HOSTNAMES="songtaipartners.up.railway.app"

